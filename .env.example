# ==============================================================================
# TeioOS Environment Variables Template (Production & Container Deployment)
# ==============================================================================
# Copy this template to '.env' at the repository root and update values:
#   cp .env.example .env
#
# REQUIRED IN PRODUCTION (APP_ENV != development):
#   - SECRET_KEY
#   - DATABASE_PASSWORD
#   - POSTGRES_PASSWORD
#   - ADMIN_PASSWORD
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Application display name used in system logging and documentation
APP_NAME=TeioOS Exam Server

# Environment mode: "production" or "development"
# In production, strict validation enforces secure non-default SECRET_KEY and DATABASE_PASSWORD
APP_ENV=production

# Enable or disable framework debug mode (False for production)
DEBUG=False

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL Container & Application DSN)
# ------------------------------------------------------------------------------
# In Docker Compose, DATABASE_HOST points to the database container service name ("db")
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=teioos
DATABASE_USER=teioos_user

# [REQUIRED] PostgreSQL user password used by FastAPI application connection pool.
# Must match POSTGRES_PASSWORD below.
DATABASE_PASSWORD=change_this_to_a_secure_database_password_in_production

# PostgreSQL Official Image Initialization Variables
POSTGRES_DB=teioos
POSTGRES_USER=teioos_user

# [REQUIRED] PostgreSQL initialization password for containerized database instance.
# Must match DATABASE_PASSWORD above.
POSTGRES_PASSWORD=change_this_to_a_secure_database_password_in_production

# ------------------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------------------
# [REQUIRED] High-entropy random 64-character hex key for signing JWT auth tokens.
# Must be set to a secure secret in production (literal default or empty string is rejected).
# Generate a new secure key via:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_character_hex_secret_key_here

# JWT signing algorithm (HS256 recommended)
ALGORITHM=HS256

# JWT access token validity period in minutes (1440 minutes = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins for cross-origin API requests.
# For single-gateway container deployment, this must match the gateway's external origin
# (e.g. http://localhost:8080 or http://<SERVER_IP>:<PORT> in a LAN deployment).
CORS_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------------------
# Initial Superadmin Account Seed Credentials
# ------------------------------------------------------------------------------
# Default admin user email address created during automatic database seeding on startup
ADMIN_EMAIL=admin@teioos.local

# [REQUIRED] Initial password assigned to the default superadmin account during database seeding
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_in_production

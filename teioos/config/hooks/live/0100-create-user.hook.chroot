#!/bin/sh
set -e

useradd -m -s /bin/bash -G audio,video,pulse,pulse-access,input examuser || useradd -m -s /bin/bash examuser
usermod -aG audio,video,pulse,pulse-access,input examuser 2>/dev/null || true
passwd -d examuser

# Explicitly ensure kiosk config is in place, regardless of skel timing
mkdir -p /home/examuser/.config/openbox
cp /etc/skel/.xinitrc /home/examuser/.xinitrc
cp /etc/skel/.bash_profile /home/examuser/.bash_profile
cp /etc/xdg/openbox/rc.xml /home/examuser/.config/openbox/rc.xml
chown -R examuser:examuser /home/examuser
chmod +x /home/examuser/.xinitrc
chmod 755 /usr/local/bin/teioos-* 2>/dev/null || true
